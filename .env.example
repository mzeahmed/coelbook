POSTGRES_DB=coelbook
POSTGRES_USER=coelbook
POSTGRES_PASSWORD=coelbook
DATABASE_URL=postgres://coelbook:coelbook@postgres:5432/coelbook?sslmode=disable
BACKEND_PORT=8080
FRONTEND_PORT=5173
ADMINER_PORT=8081
MAILPIT_PORT=8025

APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://coelbook.local

DB_HOST=localhost
DB_PORT=5432
DB_NAME=coelbook
DB_USER=coelbook
DB_PASSWORD=coelbook

JWT_SECRET=change-me

# Docker Compose uses Mailpit by default. Set these values to use another SMTP
# provider; an API run directly on the host defaults to localhost:1025.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_TLS=true
