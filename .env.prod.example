# Production configuration for docker-compose.prod.yml.
# Copy to .env.prod, fill in the values, and keep .env.prod out of Git.

# Public URL of the instance (used in password reset emails).
APP_BASE_URL=https://coelbook.example.com

# Signs the session tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Database (the PostgreSQL container is created with these).
POSTGRES_DB=coelbook
POSTGRES_USER=coelbook
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Port Coelbook listens on, on 127.0.0.1 (point the reverse proxy at it).
COELBOOK_PORT=8080

# Outgoing email, for password resets. Leave SMTP_HOST empty to disable.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=coelbook@example.com
SMTP_TLS=true
